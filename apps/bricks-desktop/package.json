{
  "name": "bricks-desktop",
  "private": true,
  "version": "2026.11.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "prepare:cua-driver": "python3 scripts/prepare_cua_driver.py --tauri-config-out .cua-driver/tauri-cua.generated.json",
    "build:app": "npm run prepare:cua-driver && tauri build --bundles app --config .cua-driver/tauri-cua.generated.json",
    "tauri": "tauri",
    "test:unit": "vitest run --config tests/vitest.config.ts",
    "test:styles": "node scripts/compare-css-centralization.mjs",
    "test:e2e": "wdio run tests/e2e/wdio.conf.ts",
    "test:types": "tsc -p tests/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "20.14.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.17",
    "katex": "0.19.0",
    "lucide-react": "^1.77.0",
    "marked": "^18.1.1",
    "mermaid": "12.1.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.8.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.5.0",
    "zustand": "^5.1.0"
  }
}
